
{%- liquid
  assign block_settings = block.settings
  assign property_key = block_settings.property_key | default: block_settings.heading | default: block.id
  assign property_name = 'properties[custom-property]' | replace: 'custom-property', property_key
  assign product_form_id = 'BuyButtons-ProductForm-section.id' | replace: 'section.id', section.id
  assign element_id = 'PersonalisationPhoto-' | append: block.id
  assign preview_mode = block_settings.preview_mode | default: 'headshot'
  if preview_mode == 'landscape'
    assign preview_image_width = 320
    assign preview_image_height = 160
  else
    assign preview_image_width = 200
    assign preview_image_height = 200
  endif
-%}

<div
  class="personalisation-field personalisation-field--photo personalisation-field--photo-{{ preview_mode }} spacing-style"
  style="{% render 'spacing-style', settings: block_settings %}"
  data-personalisation-photo
  data-preview-mode="{{ preview_mode }}"
  data-error-message="{{ 'content.personalisation.error_photo' | t | escape }}"
  {{ block.shopify_attributes }}
>
  {% if block_settings.badge != blank %}
    <span class="personalisation-field__badge">{{ block_settings.badge | escape }}</span>
  {% endif %}

  {% if block_settings.heading != blank %}
    <p class="personalisation-field__heading">{{ block_settings.heading | escape }}</p>
  {% endif %}

  {% if block_settings.description != blank %}
    <p class="personalisation-field__description">
      {{ block_settings.description | escape }}
    </p>
  {% endif %}

  <div
    class="personalisation-field__preview personalisation-field__preview--{{ preview_mode }}"
    data-photo-preview
  >
    <img
      class="personalisation-field__preview-image"
      data-photo-preview-image
      alt=""
      width="{{ preview_image_width }}"
      height="{{ preview_image_height }}"
      hidden
    >
    <canvas
      class="personalisation-field__preview-canvas"
      data-photo-canvas
      width="{{ preview_image_width }}"
      height="{{ preview_image_height }}"
      hidden
    ></canvas>
    <div class="personalisation-field__preview-placeholder" data-photo-preview-placeholder>
      <svg
        class="personalisation-field__preview-icon"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
      <p class="personalisation-field__preview-text">{{ block_settings.preview_placeholder | escape }}</p>
    </div>
  </div>

  <input
    type="file"
    id="{{ element_id }}"
    name="{{ property_name }}"
    class="personalisation-field__file-input"
    form="{{ product_form_id }}"
    accept="{{ block_settings.accept }}"
    data-photo-input
    {% if block_settings.required %}
      required
      aria-required="true"
    {% endif %}
  >

  <div class="personalisation-field__actions" data-photo-actions>
    <label class="personalisation-field__button personalisation-field__button--upload" for="{{ element_id }}">
      {{ block_settings.upload_button_text | escape }}
    </label>
    <button
      type="button"
      class="personalisation-field__button personalisation-field__button--edit"
      data-photo-edit
      hidden
    >
      {{ block_settings.edit_button_text | escape }}
    </button>
  </div>

  <div class="personalisation-field__crop-controls" data-photo-crop-controls hidden>
    <label class="personalisation-field__zoom-label" for="PersonalisationPhotoZoom-{{ block.id }}">
      {{ 'content.personalisation.zoom' | t }}
    </label>
    <input
      type="range"
      id="PersonalisationPhotoZoom-{{ block.id }}"
      class="personalisation-field__zoom-input"
      data-photo-zoom
      min="1"
      max="3"
      step="0.1"
      value="1"
    >
    <div class="personalisation-field__crop-actions">
      <button type="button" class="personalisation-field__button personalisation-field__button--save" data-photo-save>
        {{ block_settings.save_button_text | escape }}
      </button>
      <button type="button" class="personalisation-field__button personalisation-field__button--cancel" data-photo-cancel>
        {{ block_settings.cancel_button_text | escape }}
      </button>
    </div>
  </div>
</div>

<script
  src="{{ 'personalisation-photo.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% schema %}
{
  "name": "t:names.personalisation_photo",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "t:settings.personalisation.content"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "t:settings.personalisation.badge",
      "default": "t:settings.personalisation_photo.default_badge",
      "info": "t:settings.personalisation.badge_info"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.personalisation_photo.heading",
      "default": "t:settings.personalisation_photo.default_heading"
    },
    {
      "type": "text",
      "id": "description",
      "label": "t:settings.personalisation_photo.description"
    },
    {
      "type": "text",
      "id": "property_key",
      "label": "t:settings.personalisation.property_key",
      "default": "t:settings.personalisation_photo.default_property_key",
      "info": "t:settings.personalisation.property_key_info"
    },
    {
      "type": "text",
      "id": "upload_button_text",
      "label": "t:settings.personalisation_photo.upload_button_text",
      "default": "t:settings.personalisation_photo.default_upload_button_text"
    },
    {
      "type": "text",
      "id": "edit_button_text",
      "label": "t:settings.personalisation_photo.edit_button_text",
      "default": "t:settings.personalisation_photo.default_edit_button_text"
    },
    {
      "type": "text",
      "id": "save_button_text",
      "label": "t:settings.personalisation_photo.save_button_text",
      "default": "t:settings.personalisation_photo.default_save_button_text"
    },
    {
      "type": "text",
      "id": "cancel_button_text",
      "label": "t:settings.personalisation_photo.cancel_button_text",
      "default": "t:settings.personalisation_photo.default_cancel_button_text"
    },
    {
      "type": "text",
      "id": "preview_placeholder",
      "label": "t:settings.personalisation_photo.preview_placeholder",
      "default": "t:settings.personalisation_photo.default_preview_placeholder"
    },
    {
      "type": "select",
      "id": "preview_mode",
      "label": "t:settings.personalisation_photo.preview_mode",
      "options": [
        {
          "value": "headshot",
          "label": "t:settings.personalisation_photo.preview_mode_headshot"
        },
        {
          "value": "landscape",
          "label": "t:settings.personalisation_photo.preview_mode_landscape"
        }
      ],
      "default": "headshot"
    },
    {
      "type": "text",
      "id": "accept",
      "label": "t:settings.personalisation_photo.accept",
      "default": "image/*",
      "info": "t:settings.personalisation_photo.accept_info"
    },
    {
      "type": "checkbox",
      "id": "required",
      "label": "t:settings.personalisation.required",
      "default": false
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
