
{%- liquid
  assign block_settings = block.settings
  assign property_key = block_settings.property_key | default: block_settings.heading | default: block.id
  assign property_name = 'properties[custom-property]' | replace: 'custom-property', property_key
  assign product_form_id = 'BuyButtons-ProductForm-section.id' | replace: 'section.id', section.id
  assign block_id = block.id | replace: '_', '' | downcase
  assign option_group = block_settings.option_group
  assign group_entries = option_group.options.value
-%}

<div
  class="personalisation-field personalisation-field--radio spacing-style"
  style="{% render 'spacing-style', settings: block_settings %}"
  data-error-message="{{ 'content.personalisation.error_radio' | t | escape }}"
  {{ block.shopify_attributes }}
>
  {% if block_settings.badge != blank %}
    <span class="personalisation-field__badge">{{ block_settings.badge | escape }}</span>
  {% endif %}

  {% if block_settings.heading != blank %}
    <p class="personalisation-field__heading">{{ block_settings.heading | escape }}</p>
  {% endif %}

  {% if block_settings.description != blank %}
    <p class="personalisation-field__description">
      {{ block_settings.description | escape }}
    </p>
  {% endif %}

  <fieldset class="personalisation-field__fieldset">
    <legend class="visually-hidden">{{ block_settings.heading | default: property_key | escape }}</legend>

    <div class="personalisation-field__options">
      {% assign is_first_option = true %}
      {% for entry in group_entries %}
        {% liquid
          assign option_name = entry.option_name.value
          assign option_image = entry.image.value
          assign option_id = entry.system.handle | default: forloop.index
        %}

        {% if option_name != blank %}
          <div class="personalisation-field__option">
            <input
              type="radio"
              id="personalisation-radio-{{ block_id }}-{{ option_id }}"
              name="{{ property_name }}"
              value="{{ option_name | escape }}"
              class="personalisation-field__radio-input"
              form="{{ product_form_id }}"
              {% if block_settings.required and is_first_option %}
                required
                aria-required="true"
              {% endif %}
            >
            {% assign is_first_option = false %}
            <label
              class="personalisation-field__radio-label"
              for="personalisation-radio-{{ block_id }}-{{ option_id }}"
            >
              <span class="personalisation-field__option-image-wrapper">
                {% if option_image %}
                  {{
                    option_image
                    | image_url: width: 300
                    | image_tag:
                      class: 'personalisation-field__option-image',
                      loading: 'lazy',
                      widths: '150, 300',
                      alt: option_name
                  }}
                {% else %}
                  <span class="personalisation-field__option-placeholder">
                    {{ 'image' | placeholder_svg_tag }}
                  </span>
                {% endif %}
              </span>
              <span class="personalisation-field__option-label">{{ option_name | escape }}</span>
            </label>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </fieldset>
</div>

{% schema %}
{
  "name": "t:names.personalisation_radio",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "t:settings.personalisation.content"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "t:settings.personalisation.badge",
      "default": "t:settings.personalisation_radio.default_badge",
      "info": "t:settings.personalisation.badge_info"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.personalisation_radio.heading",
      "default": "t:settings.personalisation_radio.default_heading"
    },
    {
      "type": "text",
      "id": "description",
      "label": "t:settings.personalisation_radio.description"
    },
    {
      "type": "text",
      "id": "property_key",
      "label": "t:settings.personalisation.property_key",
      "default": "t:settings.personalisation_radio.default_property_key",
      "info": "t:settings.personalisation.property_key_info"
    },
    {
      "type": "checkbox",
      "id": "required",
      "label": "t:settings.personalisation.required",
      "default": false
    },
    {
      "type": "header",
      "content": "t:settings.personalisation_radio.options"
    },
    {
      "type": "metaobject",
      "id": "option_group",
      "label": "t:settings.personalisation_radio.option_group",
      "metaobject_type": "personalisation_option_group",
      "info": "t:settings.personalisation_radio.option_group_info"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
