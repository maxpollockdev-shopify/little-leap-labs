
{%- liquid
  assign block_settings = block.settings
  assign property_key = block_settings.property_key | default: block_settings.heading | default: block.id
  assign property_name = 'properties[custom-property]' | replace: 'custom-property', property_key
  assign product_form_id = 'BuyButtons-ProductForm-section.id' | replace: 'section.id', section.id
  assign block_id = block.id | replace: '_', '' | downcase
-%}

<div
  class="personalisation-field personalisation-field--radio spacing-style"
  style="{% render 'spacing-style', settings: block_settings %}"
  data-error-message="{{ 'content.personalisation.error_radio' | t | escape }}"
  {{ block.shopify_attributes }}
>
  {% if block_settings.badge != blank %}
    <span class="personalisation-field__badge">{{ block_settings.badge | escape }}</span>
  {% endif %}

  {% if block_settings.heading != blank %}
    <p class="personalisation-field__heading">{{ block_settings.heading | escape }}</p>
  {% endif %}

  {% if block_settings.description != blank %}
    <p class="personalisation-field__description">
      {{ block_settings.description | escape }}
    </p>
  {% endif %}

  <fieldset class="personalisation-field__fieldset">
    <legend class="visually-hidden">{{ block_settings.heading | default: property_key | escape }}</legend>

    <div class="personalisation-field__options">
      {% assign is_first_option = true %}
      {% for i in (1..4) %}
        {% liquid
          assign image_key = 'option_image_' | append: i
          assign label_key = 'option_label_' | append: i
          assign image = block_settings[image_key]
          assign label = block_settings[label_key]
        %}

        {% if label != blank %}
          <div class="personalisation-field__option">
            <input
              type="radio"
              id="personalisation-radio-{{ block_id }}-{{ i }}"
              name="{{ property_name }}"
              value="{{ label | escape }}"
              class="personalisation-field__radio-input"
              form="{{ product_form_id }}"
              {% if block_settings.required and is_first_option %}
                required
                aria-required="true"
              {% endif %}
            >
            {% assign is_first_option = false %}
            <label
              class="personalisation-field__radio-label"
              for="personalisation-radio-{{ block_id }}-{{ i }}"
            >
              <span class="personalisation-field__option-image-wrapper">
                {% if image %}
                  {{
                    image
                    | image_url: width: 300
                    | image_tag:
                      class: 'personalisation-field__option-image',
                      loading: 'lazy',
                      widths: '150, 300',
                      alt: label
                  }}
                {% else %}
                  <span class="personalisation-field__option-placeholder">
                    {{ 'image' | placeholder_svg_tag }}
                  </span>
                {% endif %}
              </span>
              <span class="personalisation-field__option-label">{{ label | escape }}</span>
            </label>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </fieldset>
</div>

{% schema %}
{
  "name": "t:names.personalisation_radio",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "t:settings.personalisation.content"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "t:settings.personalisation.badge",
      "default": "t:settings.personalisation_radio.default_badge",
      "info": "t:settings.personalisation.badge_info"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.personalisation_radio.heading",
      "default": "t:settings.personalisation_radio.default_heading"
    },
    {
      "type": "text",
      "id": "description",
      "label": "t:settings.personalisation_radio.description"
    },
    {
      "type": "text",
      "id": "property_key",
      "label": "t:settings.personalisation.property_key",
      "default": "t:settings.personalisation_radio.default_property_key",
      "info": "t:settings.personalisation.property_key_info"
    },
    {
      "type": "checkbox",
      "id": "required",
      "label": "t:settings.personalisation.required",
      "default": false
    },
    {
      "type": "header",
      "content": "t:settings.personalisation_radio.option_1"
    },
    {
      "type": "image_picker",
      "id": "option_image_1",
      "label": "t:settings.personalisation_radio.image"
    },
    {
      "type": "text",
      "id": "option_label_1",
      "label": "t:settings.personalisation_radio.label",
      "default": "t:settings.personalisation_radio.default_option_1"
    },
    {
      "type": "header",
      "content": "t:settings.personalisation_radio.option_2"
    },
    {
      "type": "image_picker",
      "id": "option_image_2",
      "label": "t:settings.personalisation_radio.image"
    },
    {
      "type": "text",
      "id": "option_label_2",
      "label": "t:settings.personalisation_radio.label",
      "default": "t:settings.personalisation_radio.default_option_2"
    },
    {
      "type": "header",
      "content": "t:settings.personalisation_radio.option_3"
    },
    {
      "type": "image_picker",
      "id": "option_image_3",
      "label": "t:settings.personalisation_radio.image"
    },
    {
      "type": "text",
      "id": "option_label_3",
      "label": "t:settings.personalisation_radio.label",
      "default": "t:settings.personalisation_radio.default_option_3"
    },
    {
      "type": "header",
      "content": "t:settings.personalisation_radio.option_4"
    },
    {
      "type": "image_picker",
      "id": "option_image_4",
      "label": "t:settings.personalisation_radio.image"
    },
    {
      "type": "text",
      "id": "option_label_4",
      "label": "t:settings.personalisation_radio.label",
      "default": "t:settings.personalisation_radio.default_option_4"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
