{% doc %}
  @prompt
    A magazine-style editorial layout
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-magazine-layout-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px 20px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-magazine-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: {{ block.settings.grid_gap }}px;
  }

  .ai-magazine-article-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .ai-magazine-article-{{ ai_gen_id }}--featured {
    grid-column: span 8;
    grid-row: span 2;
  }

  .ai-magazine-article-{{ ai_gen_id }}--secondary {
    grid-column: span 4;
  }

  .ai-magazine-article-{{ ai_gen_id }}--tertiary {
    grid-column: span 4;
  }

  .ai-magazine-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-magazine-article-{{ ai_gen_id }}--featured .ai-magazine-image-wrapper-{{ ai_gen_id }} {
    padding-bottom: 60%;
  }

  .ai-magazine-article-{{ ai_gen_id }}--secondary .ai-magazine-image-wrapper-{{ ai_gen_id }},
  .ai-magazine-article-{{ ai_gen_id }}--tertiary .ai-magazine-image-wrapper-{{ ai_gen_id }} {
    padding-bottom: 75%;
  }

  .ai-magazine-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-magazine-image-wrapper-{{ ai_gen_id }} svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-magazine-content-{{ ai_gen_id }} {
    padding: {{ block.settings.content_padding }}px 0;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }

  .ai-magazine-category-{{ ai_gen_id }} {
    font-size: {{ block.settings.category_size }}px;
    color: {{ block.settings.category_color }};
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 8px;
    font-weight: 600;
  }

  .ai-magazine-title-{{ ai_gen_id }} {
    color: {{ block.settings.title_color }};
    margin: 0 0 12px;
    line-height: 1.2;
  }

  .ai-magazine-article-{{ ai_gen_id }}--featured .ai-magazine-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.featured_title_size }}px;
  }

  .ai-magazine-article-{{ ai_gen_id }}--secondary .ai-magazine-title-{{ ai_gen_id }},
  .ai-magazine-article-{{ ai_gen_id }}--tertiary .ai-magazine-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.secondary_title_size }}px;
  }

  .ai-magazine-excerpt-{{ ai_gen_id }} {
    font-size: {{ block.settings.excerpt_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    margin-bottom: 16px;
  }

  .ai-magazine-meta-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: {{ block.settings.meta_size }}px;
    color: {{ block.settings.meta_color }};
    margin-top: auto;
  }

  .ai-magazine-author-{{ ai_gen_id }} {
    font-weight: 500;
  }

  .ai-magazine-date-{{ ai_gen_id }} {
    opacity: 0.7;
  }

  .ai-magazine-link-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  @media screen and (max-width: 989px) {
    .ai-magazine-article-{{ ai_gen_id }}--featured {
      grid-column: span 12;
      grid-row: span 1;
    }

    .ai-magazine-article-{{ ai_gen_id }}--secondary {
      grid-column: span 6;
    }

    .ai-magazine-article-{{ ai_gen_id }}--tertiary {
      grid-column: span 6;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-magazine-layout-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding | times: 0.6 }}px 16px;
    }

    .ai-magazine-grid-{{ ai_gen_id }} {
      gap: {{ block.settings.grid_gap | times: 0.7 }}px;
    }

    .ai-magazine-article-{{ ai_gen_id }}--secondary,
    .ai-magazine-article-{{ ai_gen_id }}--tertiary {
      grid-column: span 12;
    }

    .ai-magazine-article-{{ ai_gen_id }}--featured .ai-magazine-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.featured_title_size | times: 0.7 }}px;
    }

    .ai-magazine-article-{{ ai_gen_id }}--secondary .ai-magazine-title-{{ ai_gen_id }},
    .ai-magazine-article-{{ ai_gen_id }}--tertiary .ai-magazine-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.secondary_title_size | times: 0.8 }}px;
    }

    .ai-magazine-content-{{ ai_gen_id }} {
      padding: {{ block.settings.content_padding | times: 0.7 }}px 0;
    }
  }
{% endstyle %}

<div class="ai-magazine-layout-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-magazine-grid-{{ ai_gen_id }}">
    {% if block.settings.featured_article != blank %}
      <article class="ai-magazine-article-{{ ai_gen_id }} ai-magazine-article-{{ ai_gen_id }}--featured">
        <div class="ai-magazine-image-wrapper-{{ ai_gen_id }}">
          {% if block.settings.featured_article.image %}
            <img
              src="{{ block.settings.featured_article.image | image_url: width: 1200 }}"
              alt="{{ block.settings.featured_article.image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.featured_article.image.width }}"
              height="{{ block.settings.featured_article.image.height }}"
              class="ai-magazine-image-{{ ai_gen_id }}"
            >
          {% else %}
            {{ 'image' | placeholder_svg_tag }}
          {% endif %}
        </div>
        <div class="ai-magazine-content-{{ ai_gen_id }}">
          {% if block.settings.show_category and block.settings.featured_article.tags.size > 0 %}
            <div class="ai-magazine-category-{{ ai_gen_id }}">
              {{ block.settings.featured_article.tags.first }}
            </div>
          {% endif %}
          <h2 class="ai-magazine-title-{{ ai_gen_id }}">
            {{ block.settings.featured_article.title }}
          </h2>
          {% if block.settings.show_excerpt and block.settings.featured_article.excerpt != blank %}
            <div class="ai-magazine-excerpt-{{ ai_gen_id }}">
              {{ block.settings.featured_article.excerpt | strip_html | truncate: 180 }}
            </div>
          {% endif %}
          {% if block.settings.show_meta %}
            <div class="ai-magazine-meta-{{ ai_gen_id }}">
              {% if block.settings.featured_article.author != blank %}
                <span class="ai-magazine-author-{{ ai_gen_id }}">{{ block.settings.featured_article.author }}</span>
              {% endif %}
              <span class="ai-magazine-date-{{ ai_gen_id }}">{{ block.settings.featured_article.published_at | date: '%B %d, %Y' }}</span>
            </div>
          {% endif %}
        </div>
        <a href="{{ block.settings.featured_article.url }}" class="ai-magazine-link-{{ ai_gen_id }}" aria-label="Read {{ block.settings.featured_article.title }}"></a>
      </article>
    {% endif %}

