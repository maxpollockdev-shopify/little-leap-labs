
<div
  class="personalisation spacing-style"
  style="{% render 'spacing-style', settings: block.settings %}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.heading != blank %}
    <div class="personalisation__intro">
      <span class="personalisation__sparkle" aria-hidden="true"></span>
      <h3 class="personalisation__heading">{{ block.settings.heading | escape }}</h3>
    </div>
  {% endif %}

  <div class="personalisation__fields">
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .personalisation {
    --plll-green: #55966e;
    --plll-green-dark: #467a59;
    --plll-yellow: #f6bb12;
    --plll-yellow-soft: #fde68a;
    --plll-cream: #f7f1ed;
    --plll-brown: #5d2b09;
    --plll-ink: #170b02;
    --plll-peach: #fff9f2;
    --plll-error: #c45c4a;
    --plll-error-soft: #fff0ed;
    --plll-error-shadow: rgb(196 92 74 / 0.28);

    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    gap: 1.25rem;
    padding: 1.5rem 1.25rem;
    overflow: hidden;
    border: 2px solid rgb(93 43 9 / 0.12);
    border-radius: 18px;
    background:
      radial-gradient(circle at 12% 18%, rgb(246 187 18 / 0.18) 0, transparent 42%),
      radial-gradient(circle at 88% 8%, rgb(85 150 110 / 0.16) 0, transparent 36%),
      linear-gradient(160deg, #fffdf9 0%, var(--plll-cream) 100%);
    box-shadow: 4px 4px 0 rgb(85 150 110 / 0.12);
  }

  .personalisation::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, rgb(93 43 9 / 0.08) 1px, transparent 1px);
    background-size: 16px 16px;
    mask-image: linear-gradient(to bottom, black, transparent 85%);
    pointer-events: none;
  }

  .personalisation__intro {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .personalisation__sparkle {
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--plll-yellow);
    border: 2px solid var(--plll-brown);
    box-shadow: 2px 2px 0 rgb(93 43 9 / 0.15);
    transform: rotate(-8deg);
  }

  .personalisation__sparkle::before,
  .personalisation__sparkle::after {
    content: '';
    position: absolute;
    background: var(--plll-brown);
    border-radius: 1px;
  }

  .personalisation__sparkle::before {
    width: 2px;
    height: 10px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  .personalisation__sparkle::after {
    width: 10px;
    height: 2px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  .personalisation__sparkle {
    position: relative;
  }

  .personalisation__heading {
    position: relative;
    margin: 0;
    font-family: var(--font-subheading--family);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: var(--font-subheading--weight);
    line-height: 1.1;
    color: var(--plll-green);
    transform: rotate(-1deg);
  }

  .personalisation__heading::after {
    content: '';
    position: absolute;
    left: -0.15em;
    right: -0.1em;
    bottom: 0.05em;
    height: 0.45em;
    background: #f6bb124d;
    border-radius: 0.2em;
    z-index: -1;
    transform: rotate(-1.5deg);
  }

  .personalisation__fields {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
  }

  .personalisation-field {
    --field-accent: var(--plll-green);
    --field-shadow: rgb(85 150 110 / 0.28);

    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: 1.15rem 1.15rem 1.15rem 1.35rem;
    color: var(--plll-ink);
    background: #fff;
    border: 2px solid rgb(93 43 9 / 0.18);
    border-left: 6px solid var(--field-accent);
    border-radius: 16px;
    box-shadow: 3px 3px 0 var(--field-shadow);
    transition:
      transform 0.28s cubic-bezier(0.34, 1.4, 0.64, 1),
      box-shadow 0.28s ease;
  }

  .personalisation-field:nth-child(3n + 1) {
    transform: rotate(-0.55deg);
  }

  .personalisation-field:nth-child(3n + 2) {
    transform: rotate(0.45deg);
  }

  .personalisation-field:nth-child(3n) {
    transform: rotate(-0.25deg);
  }

  .personalisation-field:hover {
    transform: rotate(0deg) translateY(-3px);
    box-shadow: 5px 5px 0 var(--field-shadow);
  }

  .personalisation-field--text {
    --field-accent: var(--plll-green);
    --field-shadow: rgb(85 150 110 / 0.28);
  }

  .personalisation-field--photo {
    --field-accent: var(--plll-yellow);
    --field-shadow: rgb(246 187 18 / 0.35);
  }

  .personalisation-field--radio {
    --field-accent: var(--plll-brown);
    --field-shadow: rgb(93 43 9 / 0.18);
  }

  .personalisation-field__badge {
    position: absolute;
    top: -0.65rem;
    right: 1rem;
    padding: 0.2rem 0.65rem;
    font-family: var(--font-subheading--family);
    font-size: 0.95rem;
    line-height: 1;
    color: var(--plll-brown);
    background: var(--plll-yellow-soft);
    border: 2px solid var(--plll-brown);
    border-radius: 999px;
    transform: rotate(4deg);
    box-shadow: 2px 2px 0 rgb(93 43 9 / 0.12);
  }

  .personalisation-field__heading {
    margin: 0;
    padding-right: 4rem;
    font-family: var(--font-subheading--family);
    font-size: 1.4rem;
    font-weight: var(--font-subheading--weight);
    line-height: 1.15;
    color: var(--plll-green);
  }

  .personalisation-field--photo .personalisation-field__heading,
  .personalisation-field--radio .personalisation-field__heading {
    color: var(--plll-brown);
  }

  .personalisation-field__description {
    margin: 0;
    margin-bottom: .5rem !important;
    font-size: .75rem;
    line-height: 1.55;
    color: #170b02b8;
  }

  .personalisation-field__input {
    width: 100%;
    padding: 0.9rem 1rem;
    font-size: 1rem;
    color: var(--plll-ink);
    background: var(--plll-peach);
    border: 2px dashed rgb(93 43 9 / 0.35);
    border-radius: 14px;
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.8);
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease,
      transform 0.2s ease;
  }

  .personalisation-field__input::placeholder {
    color: rgb(23 11 2 / 0.4);
    font-style: italic;
  }

  .personalisation-field__input:hover {
    background: #fff;
  }

  .personalisation-field__input:focus {
    outline: none;
    border-style: solid;
    border-color: var(--plll-green);
    background: #fff;
    transform: scale(1.01);
  }

  .personalisation-field__input-wrapper {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    width: 100%;
  }

  .personalisation-field__char-count {
    margin: 0;
    font-size: 0.75rem;
    line-height: 1.3;
    text-align: right;
    color: rgb(23 11 2 / 0.55);
  }

  .personalisation-field--at-max .personalisation-field__char-count {
    color: var(--plll-brown);
    font-weight: 600;
  }

  .personalisation-field__input:user-invalid {
    border-style: solid;
    border-color: var(--plll-error);
    background: var(--plll-error-soft);
    transform: none;
  }

  .personalisation-field--photo:has(.personalisation-field__file-input:user-invalid) .personalisation-field__preview {
    border-style: solid;
    border-color: var(--plll-error);
    background: var(--plll-error-soft);
    box-shadow:
      inset 0 0 0 4px #fff,
      3px 3px 0 var(--plll-error-shadow);
  }

  .personalisation-field--photo:has(.personalisation-field__file-input:user-invalid) .personalisation-field__button {
    border-color: var(--plll-error);
    color: var(--plll-error);
    background: var(--plll-error-soft);
    box-shadow: 2px 2px 0 var(--plll-error);
  }

  .personalisation-field--radio:has(.personalisation-field__radio-input:user-invalid) .personalisation-field__option-image-wrapper {
    border-color: rgb(196 92 74 / 0.55);
    box-shadow: inset 0 0 0 1px rgb(196 92 74 / 0.2);
  }

  .personalisation-field:has(:user-invalid) {
    --field-accent: var(--plll-error);
    --field-shadow: var(--plll-error-shadow);
    border-color: rgb(196 92 74 / 0.45);
    animation: personalisation-field-shake 0.45s ease;
  }

  .personalisation-field:has(:user-invalid)::after {
    content: attr(data-error-message);
    display: block;
    margin-top: 0.15rem;
    font-family: var(--font-subheading--family);
    font-size: 0.95rem;
    line-height: 1.3;
    color: var(--plll-error);
  }

  .personalisation-field:has(:user-invalid) .personalisation-field__heading {
    color: var(--plll-error);
  }

  @keyframes personalisation-field-shake {
    0%,
    100% {
      transform: translateX(0);
    }

    20% {
      transform: translateX(-5px);
    }

    40% {
      transform: translateX(5px);
    }

    60% {
      transform: translateX(-3px);
    }

    80% {
      transform: translateX(3px);
    }
  }

  .personalisation-field__preview {
    position: relative;
    width: 11.5rem;
    max-width: 100%;
    margin: .25rem auto 1rem;
    overflow: hidden;
    border: 3px dashed var(--plll-yellow);
    background:
      radial-gradient(circle at 30% 25%, rgb(255 255 255 / 0.95) 0, transparent 55%),
      linear-gradient(180deg, #fff 0%, var(--plll-peach) 100%);
    box-shadow:
      inset 0 0 0 4px #fff,
      3px 3px 0 rgb(246 187 18 / 0.25);
    transition: transform 0.25s ease;
  }

  .personalisation-field__preview--headshot {
    aspect-ratio: 1;
    border-radius: 50%;
    transform: rotate(-2deg);
  }

  .personalisation-field__preview--landscape {
    width: 22rem;
    aspect-ratio: 6 / 3;
    border-radius: 14px;
    transform: rotate(-0.5deg);
  }

  .personalisation-field--photo:hover .personalisation-field__preview--headshot {
    transform: rotate(0deg) scale(1.02);
  }

  .personalisation-field--photo:hover .personalisation-field__preview--landscape {
    transform: rotate(0deg) scale(1.01);
  }

  .personalisation-field__preview-image {
    display: none;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .personalisation-field__preview-image:not([hidden]) {
    display: block;
  }

  .personalisation-field__preview-canvas {
    display: none;
    width: 100%;
    height: 100%;
    cursor: grab;
    touch-action: none;
  }

  .personalisation-field__preview-canvas:not([hidden]) {
    display: block;
  }

  .personalisation-field__preview-canvas.is-dragging {
    cursor: grabbing;
  }

  .personalisation-field--photo-editing .personalisation-field__preview {
    border-style: solid;
    border-color: var(--plll-green);
  }

  .personalisation-field__actions {
    display: flex;
    gap: 0.5rem;
    width: 100%;
  }

  .personalisation-field__actions[hidden] {
    display: none;
  }

  .personalisation-field--photo:not(.personalisation-field--photo-has-image) .personalisation-field__button--edit {
    display: none;
  }

  .personalisation-field--photo-editing .personalisation-field__actions {
    display: none;
  }

  .personalisation-field__actions .personalisation-field__button {
    flex: 1;
    width: auto;
  }

  .personalisation-field__button--edit {
    color: var(--plll-cream);
    background: var(--plll-green);
  }

  .personalisation-field__button--edit:hover {
    background: var(--plll-green-dark);
  }

  .personalisation:has(.personalisation-field--photo-editing) {
    overflow: visible;
  }

  .personalisation-field--photo-editing {
    overflow: visible;
  }

  .personalisation-field__media {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .personalisation-field__edit-frame {
    position: relative;
    display: inline-block;
    max-width: 100%;
  }

  .personalisation-field--photo-editing .personalisation-field__preview {
    margin-bottom: 0;
  }

  .personalisation-field__zoom-controls {
    position: absolute;
    top: 0;
    left: calc(100% + 0.35rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    height: 100%;
    padding-inline-start: 0.15rem;
  }

  .personalisation-field__zoom-controls[hidden] {
    display: none;
  }

  .personalisation-field__zoom-label {
    font-family: var(--font-subheading--family);
    font-size: 0.85rem;
    line-height: 1;
    color: var(--plll-brown);
  }

  .personalisation-field__zoom-input {
    flex: 1 1 auto;
    width: 1.25rem;
    min-height: 5rem;
    height: auto;
    margin: 0;
    accent-color: var(--plll-green);
    writing-mode: vertical-lr;
    direction: rtl;
    -webkit-appearance: slider-vertical;
    appearance: slider-vertical;
  }

  .personalisation-field__crop-hint {
    width: 100%;
    margin: 0.35rem 0 0;
    font-family: var(--font-subheading--family);
    font-size: 0.85rem;
    line-height: 1.35;
    text-align: center;
    color: rgb(23 11 2 / 0.65);
  }

  .personalisation-field__crop-hint[hidden] {
    display: none;
  }

  .personalisation-field__crop-actions {
    display: flex;
    gap: 0.5rem;
    width: 100%;
    margin-top: 0.65rem;
  }

  .personalisation-field__crop-actions[hidden] {
    display: none;
  }

  .personalisation-field__crop-actions .personalisation-field__button {
    flex: 1;
    width: auto;
    max-width: 280px;
    margin-inline: auto;
  }

  .personalisation-field__button--save {
    color: var(--plll-cream);
    background: var(--plll-green);
  }

  .personalisation-field__button--save:hover {
    background: var(--plll-green-dark);
  }

  .personalisation-field__button--cancel {
    color: var(--plll-brown);
    background: #fff;
  }

  .personalisation-field__button--cancel:hover {
    color: var(--plll-brown);
    background: var(--plll-cream);
  }

  .personalisation-field__preview-placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 1rem;
    text-align: center;
    color: rgb(93 43 9 / 0.55);
    pointer-events: none;
  }

  .personalisation-field__preview-placeholder[hidden] {
    display: none;
  }

  .personalisation-field__preview-icon {
    width: 2.25rem;
    height: 2.25rem;
    color: var(--plll-green);
    opacity: 0.75;
  }

  .personalisation-field__preview-text {
    margin: 0;
    font-family: var(--font-subheading--family);
    font-size: 0.95rem;
    line-height: 1.25;
    color: var(--plll-brown);
  }

  .personalisation-field__file-input {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .personalisation-field__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    width: 100%;
    padding: 0.75rem 1.25rem;
    border: 2px solid var(--plll-brown);
    border-radius: 999px;
    font-family: var(--font-subheading--family);
    font-size: 1.15rem;
    font-weight: var(--font-subheading--weight);
    line-height: 1.2;
    color: var(--plll-brown);
    background: var(--plll-yellow);
    box-shadow: 2px 2px 0 var(--plll-brown);
    cursor: pointer;
    transition:
      transform 0.22s cubic-bezier(0.34, 1.4, 0.64, 1),
      background-color 0.22s ease,
      color 0.22s ease;
  }

  .personalisation-field__button:hover {
    color: var(--plll-cream);
    background: var(--plll-green);
    transform: translateY(-1px) scale(1.02);
  }

  .personalisation-field__button:active {
    transform: translateY(1px) scale(0.98);
    box-shadow: 1px 1px 0 var(--plll-brown);
  }

  .personalisation-field__options {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(6.5rem, 1fr));
    gap: 1rem;
  }

  .personalisation-field__option {
    position: relative;
  }

  .personalisation-field__radio-input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .personalisation-field__radio-label {
    display: block;
    cursor: pointer;
  }

  .personalisation-field__option-image-wrapper {
    display: block;
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 50%;
    background: var(--plll-peach);
    transition:
      border-color 0.22s ease,
      transform 0.22s cubic-bezier(0.34, 1.4, 0.64, 1),
      box-shadow 0.22s ease;
  }

  .personalisation-field__radio-label:hover .personalisation-field__option-image-wrapper {
    transform: translateY(-3px) rotate(2deg);
    box-shadow: 0 6px 14px rgb(93 43 9 / 0.12);
  }

  .personalisation-field__option-image,
  .personalisation-field__option-placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .personalisation-field__option-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .personalisation-field__option-placeholder svg {
    width: 55%;
    height: 55%;
    opacity: 0.25;
  }

  .personalisation-field__radio-input:checked + .personalisation-field__radio-label .personalisation-field__option-image-wrapper {
    border-color: var(--plll-yellow);
    box-shadow:
      0 0 0 3px var(--plll-green),
      0 8px 16px rgb(85 150 110 / 0.18);
    transform: scale(1.06);
  }

  .personalisation-field__option-label {
    display: block;
    margin-top: 0.5rem;
    text-align: center;
    font-family: var(--font-subheading--family);
    font-size: 1rem;
    line-height: 1.2;
    color: var(--plll-brown);
  }

  .personalisation-field__fieldset {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }

  @media screen and (max-width: 749px) {
    .personalisation {
      padding: 1.15rem 1rem;
    }

    .personalisation-field__options {
      grid-template-columns: repeat(2, 1fr);
    }

    .personalisation-field__heading {
      font-size: 1.2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .personalisation-field,
    .personalisation-field__button,
    .personalisation-field__option-image-wrapper,
    .personalisation-field__input,
    .personalisation-field__preview {
      transition: none;
    }

    .personalisation-field:nth-child(n) {
      transform: none;
    }

    .personalisation-field:hover {
      transform: none;
    }

    .personalisation-field:has(:user-invalid) {
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.personalisation",
  "tag": null,
  "blocks": [
    {
      "type": "_personalisation-text"
    },
    {
      "type": "_personalisation-photo"
    },
    {
      "type": "_personalisation-radio-group"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.personalisation.heading",
      "default": "t:settings.personalisation.default_heading"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.personalisation",
      "category": "t:categories.product",
      "blocks": {
        "text-1": {
          "type": "_personalisation-text",
          "settings": {
            "badge": "t:settings.personalisation_text.default_badge",
            "heading": "t:settings.personalisation_text.default_heading",
            "property_key": "t:settings.personalisation_text.default_property_key"
          }
        },
        "photo-1": {
          "type": "_personalisation-photo",
          "settings": {
            "badge": "t:settings.personalisation_photo.default_badge",
            "heading": "t:settings.personalisation_photo.default_heading",
            "property_key": "t:settings.personalisation_photo.default_property_key"
          }
        },
        "radio-1": {
          "type": "_personalisation-radio-group",
          "settings": {
            "badge": "t:settings.personalisation_radio.default_badge",
            "heading": "t:settings.personalisation_radio.default_heading",
            "property_key": "t:settings.personalisation_radio.default_property_key"
          }
        }
      },
      "block_order": ["text-1", "photo-1", "radio-1"]
    }
  ]
}
{% endschema %}
