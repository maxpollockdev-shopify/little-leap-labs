{% schema %}
{
  "name": "Magazine editorial layout",
  "settings": [
    {
      "type": "header",
      "content": "Articles"
    },
    {
      "type": "article",
      "id": "featured_article",
      "label": "Featured article"
    },
    {
      "type": "article",
      "id": "article_2",
      "label": "Article 2"
    },
    {
      "type": "article",
      "id": "article_3",
      "label": "Article 3"
    },
    {
      "type": "article",
      "id": "article_4",
      "label": "Article 4"
    },
    {
      "type": "article",
      "id": "article_5",
      "label": "Article 5"
    },
    {
      "type": "article",
      "id": "article_6",
      "label": "Article 6"
    },
    {
      "type": "header",
      "content": "Display options"
    },
    {
      "type": "checkbox",
      "id": "show_category",
      "label": "Show category",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_meta",
      "label": "Show author and date",
      "default": true
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "section_padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Section padding",
      "default": 50
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Grid gap",
      "default": 30
    },
    {
      "type": "range",
      "id": "content_padding",
      "min": 10,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Content padding",
      "default": 20
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "featured_title_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Featured title size",
      "default": 40
    },
    {
      "type": "range",
      "id": "secondary_title_size",
      "min": 14,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Secondary title size",
      "default": 22
    },
    {
      "type": "range",
      "id": "category_size",
      "min": 10,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Category size",
      "default": 12
    },
    {
      "type": "range",
      "id": "excerpt_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Excerpt size",
      "default": 16
    },
    {
      "type": "range",
      "id": "meta_size",
      "min": 10,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Meta size",
      "default": 13
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Title",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "category_color",
      "label": "Category",
      "default": "#55966e"
    },
    {
      "type": "color",
      "id": "meta_color",
      "label": "Meta",
      "default": "#999999"
    }
  ],
  "presets": [
    {
      "name": "Magazine editorial layout"
    }
  ]
}
{% endschema %}